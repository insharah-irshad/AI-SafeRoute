      "id": "263ca4ef-9bc6-4baa-ae45-1d3e7c5cc70a",
      "name": "Receive Report Submission",
      "webhookId": "455184ac-e6de-40d6-9d2b-51bdb07f7170"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"You are a safety-report analyzer for a women's route-safety platform in Pakistan. Read the user's free-text description of a location and extract structured safety data.\\n\\nRules:\\n- Only extract issues explicitly stated or clearly implied in the text. Do not invent details.\\n- issues must be chosen from this fixed list only: [\\\"poor lighting\\\", \\\"low activity\\\", \\\"isolated area\\\", \\\"no transport access\\\", \\\"harassment reported\\\", \\\"unsafe crossing\\\", \\\"construction/obstruction\\\", \\\"other\\\"]\\n- risk_level must be one of: \\\"low\\\", \\\"medium\\\", \\\"high\\\"\\n- time_context must be one of: \\\"day\\\", \\\"evening\\\", \\\"night\\\", \\\"unspecified\\\"\\n- Respond with ONLY valid JSON.\\n\\nLocation: {{ $json.body.location_text }}\\nTravel time: {{ $json.body.travel_time }}\\nSafety rating: {{ $json.body.safety_rating }}\\nDescription: \\\"{{ $json.body.description }}\\\"\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.2,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "535c5c67-a1f0-4da3-b403-9979f385dcc6",
      "name": "Call AI Analysis",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ooEo6r7GWZFJlhVw",
          "name": "gemini"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst rawText = response.candidates?.[0]?.content?.parts?.[0]?.text || \"{}\";\nlet parsed;\ntry { parsed = JSON.parse(rawText); }\ncatch (e) { parsed = { issues: [\"other\"], risk_level: \"medium\", time_context: \"unspecified\" }; }\n\nconst body = $('Receive Report Submission').item.json.body;\nconst issuesArray = parsed.issues || [\"other\"];\n\nreturn {\n  json: {\n    source: \"app_survey\",\n    city: body.city,\n    location_text: body.location_text,\n    latitude: null,\n    longitude: null,\n    travel_time: body.travel_time,\n    transport_method: body.transport_method,\n    safety_rating: body.safety_rating,\n    description: body.description,\n    issues: issuesArray,\n    risk_level: parsed.risk_level || \"medium\",\n    time_context: parsed.time_context || \"unspecified\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
