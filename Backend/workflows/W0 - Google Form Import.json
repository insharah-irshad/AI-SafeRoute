    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Helper: find a field by partial (case-insensitive, trim-safe) match\nfunction findField(item, partial) {\n  const keys = Object.keys(item);\n  const match = keys.find(k => k.trim().toLowerCase().includes(partial.toLowerCase()));\n  return match ? (item[match] || \"\").toString().trim() : \"\";\n}\n\nconst item = $input.item.json;\n\nconst locationText = findField(item, \"areas/routes\");\nconst travelTimeUnsafe = findField(item, \"during which time\");\nconst safetyRatingRaw = findField(item, \"how safe do you feel\");\nconst safetyRating = parseInt(safetyRatingRaw) || null;\n\n// Combine all free-text safety context into one description\nconst descriptionParts = [\n  findField(item, \"makes this route unsafe\"),\n  findField(item, \"specific point/location\"),\n  findField(item, \"improvement would make\"),\n  findField(item, \"biggest challenge\"),\n  findField(item, \"changed your route\"),\n  findField(item, \"additional details\"),\n  findField(item, \"additional experience\")\n].filter(part => part && part !== \".\" && part.length > 1);\n\nconst description = descriptionParts.join(\". \");\n\n// Best-effort city guess from location text (before first comma)\nconst city = locationText.split(\",\")[0]?.trim() || \"\";\n\nreturn {\n  json: {\n    source: \"google_form\",\n    city: city,\n    location_text: locationText,\n    latitude: null,\n    longitude: null,\n    travel_time: travelTimeUnsafe,\n    transport_method: findField(item, \"transport\"),\n    safety_rating: safetyRating,\n    description: description\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "8e308f89-b758-4198-a80c-d387a174d3d6",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"You are a safety-report analyzer for a women's route-safety platform in Pakistan. Read the user's free-text description of a location and extract structured safety data.\\n\\nRules:\\n- Only extract issues explicitly stated or clearly implied in the text. Do not invent details.\\n- issues must be chosen from this fixed list only: [\\\"poor lighting\\\", \\\"low activity\\\", \\\"isolated area\\\", \\\"no transport access\\\", \\\"harassment reported\\\", \\\"unsafe crossing\\\", \\\"construction/obstruction\\\", \\\"other\\\"]\\n- risk_level must be one of: \\\"low\\\", \\\"medium\\\", \\\"high\\\"\\n- time_context must be one of: \\\"day\\\", \\\"evening\\\", \\\"night\\\", \\\"unspecified\\\"\\n- Respond with ONLY valid JSON. No preamble, no explanation, no markdown code fences.\\n\\nOutput schema:\\n{\\\"issues\\\": string[], \\\"risk_level\\\": \\\"low\\\"|\\\"medium\\\"|\\\"high\\\", \\\"time_context\\\": \\\"day\\\"|\\\"evening\\\"|\\\"night\\\"|\\\"unspecified\\\", \\\"summary\\\": string}\\n\\nLocation: {{ $json.location_text }}\\nReported time of travel: {{ $json.travel_time }}\\nUser safety rating (1-5, lower = less safe): {{ $json.safety_rating }}\\nDescription: \\\"{{ $json.description }}\\\"\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.2,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        416,
        0
      ],
      "id": "c45da2a5-23b4-477c-8a03-736095929def",
      "name": "HTTP Request",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ooEo6r7GWZFJlhVw",
          "name": "gemini"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $input.item.json;\nconst rawText = response.candidates?.[0]?.content?.parts?.[0]?.text || \"{}\";\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  parsed = {\n    issues: [\"other\"],\n    risk_level: \"medium\",\n    time_context: \"unspecified\",\n    summary: \"Could not parse AI response\"\n  };\n}\n\nconst original = $('Code in JavaScript').item.json;\n\n// Format issues as a Postgres array literal string, e.g. {\"poor lighting\",\"low activity\"}\nconst issuesArray = parsed.issues || [\"other\"];\nconst issuesPgLiteral = \"{\" + issuesArray.map(i => `\"${i.replace(/\"/g, '\\\\\"')}\"`).join(\",\") + \"}\";\n\nreturn {\n  json: {\n    ...original,\n    issues: issuesArray,\n    issues_pg: issuesPgLiteral,   // <-- new field, use THIS one in Postgres node\n    risk_level: parsed.risk_level || \"medium\",\n    time_context: parsed.time_context || \"unspecified\",\n    summary: parsed.summary || \"\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
